#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""repo-summarize: turn a repo into a short book of Markdown docs."""
import argparse
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_ABORT, EXIT_CAPPED, EXIT_UNSAFE = 0, 1, 2, 3, 4, 5

PROMPT_LIMIT = 110_000
BATCH_BYTES = 60_000
FILE_LINES = 400
CONDENSE_BYTES = 80_000
MAX_FILE = 100_000
BINARY_PROBE = 8192
BUDGET_INSTR = 8_000
BUDGET_CATALOG = 12_000
BUDGET_TESTS = 4_000
REPLY_LIMIT = 64_000
MAX_REFS = 8
REF_MIN = 5
REF_MAX = 40
IDENT_WINDOW = 5
SHIM_RATIO = 0.8
MAX_CHAPTERS = 12
TIMEOUT = 300
BREAKER = 3
KEEP_RUNS = 3
EDGE_JACCARD = 0.20
NEW_FILES_RATIO = 0.10
RELATED_MAX = 3
DEFAULT_CMD = "agy --disable-slash-commands -p"
MARKER = "repo-summarize:v3"


# --- discover ---------------------------------------------------------------

SKIP_REASONS = ("symlink", "unsafe-path", "binary", "too-large", "lockfile", "minified",
                "generated-docs", "secret-file", "unsupported-type")
CODE_EXTS = {".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".lua", ".sh", ".zsh", ".sql", ".cpp", ".c",
             ".h", ".hpp", ".java", ".cmake", ".kt", ".swift", ".yml", ".yaml", ".toml", ".json",
             ".properties", ".ini", ".cfg"}
LOCKFILES = {"package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb", "Cargo.lock", "go.sum", "poetry.lock"}
ENV_SAFE = {".env.example", ".env.sample", ".env.template"}
SECRET_GLOBS = ("*.pem", "*.key", "*.p12", "*id_rsa*", "*credentials*.json")
UNSAFE_PATH = re.compile(r"[\x00-\x1f\x7f`|]")
SHEBANG = re.compile(rb"#!.*\b(bash|sh|zsh|python\d*|node|ruby|perl)\b")


@dataclass
class Discovery:
    root: Path
    discovered: list[str]
    included: list[str]
    skipped: dict[str, list[str]]


def _list_files(root: Path) -> list[str]:
    git = subprocess.run(["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
                         capture_output=True)
    if git.returncode == 0:
        return sorted(set(git.stdout.decode(errors="surrogateescape").split("\0")) - {""})
    out = []
    for dp, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d != ".git"]
        out += [os.path.relpath(os.path.join(dp, n), root) for n in names]
    return sorted(out)


def _skip_reason(root: Path, rel: str) -> str | None:
    path, name, parts = root / rel, Path(rel).name, Path(rel).parts
    if UNSAFE_PATH.search(rel):
        return "unsafe-path"
    if path.is_symlink():
        return "symlink"
    if parts[:2] in (("docs", "architecture"), ("docs", ".repo-summarize")):
        return "generated-docs"
    if (name.startswith(".env") and name not in ENV_SAFE) or "secrets" in parts[:-1] \
            or any(fnmatch.fnmatch(name, g) for g in SECRET_GLOBS):
        return "secret-file"
    if name in LOCKFILES or name.endswith(".lock"):
        return "lockfile"
    if re.search(r"\.min\.(js|css)$", name):
        return "minified"
    if not path.is_file():
        return "unsupported-type"
    with path.open("rb") as f:
        head = f.read(BINARY_PROBE)
    suffix = path.suffix
    if name.startswith("Dockerfile") or name in {"Makefile", "justfile"}:
        ok = True
    elif suffix == ".md":
        ok = len(parts) == 1 or parts[0] == ".github"
    elif suffix or name.startswith("."):
        ok = suffix in CODE_EXTS or name in ENV_SAFE
    else:
        ok = bool(SHEBANG.match(head.split(b"\n", 1)[0]))
    if not ok:
        return "unsupported-type"
    if b"\0" in head:
        return "binary"
    if path.stat().st_size > MAX_FILE:
        return "too-large"
    return None


def discover(root: Path) -> Discovery:
    files = _list_files(root)
    d = Discovery(root, files, [], {})
    for rel in files:
        reason = _skip_reason(root, rel)
        if reason:
            d.skipped.setdefault(reason, []).append(rel)
        else:
            d.included.append(rel)
    d.included.sort()
    return d


REDACTED = "[REDACTED]"
PEM_BEGIN = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")
PEM_END = re.compile(r"-----END [A-Z ]*PRIVATE KEY-----")
SECRET_RE = re.compile(
    r"AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|sk-[A-Za-z0-9_-]{20,}|xox[abpr]-[A-Za-z0-9-]+"
    r"|(?P<key>(?i:password|secret|token|api_?key)\s*[:=]\s*['\"]?)[^\s'\"]{8,}")


def redact_text(text: str) -> tuple[str, int]:
    out, count, in_pem = [], 0, False
    for line in text.split("\n"):
        if in_pem or PEM_BEGIN.search(line):
            count += not in_pem
            in_pem = not PEM_END.search(line)
            out.append(REDACTED)
            continue
        line, n = SECRET_RE.subn(lambda m: (m["key"] or "") + REDACTED, line)
        count += n
        out.append(line)
    return "\n".join(out), count


def scan_secret(text: str) -> bool:
    return redact_text(text)[1] > 0


@dataclass
class Snapshot:
    dir: Path
    sha256: dict[str, str]
    manifest_sha256: str


def take_snapshot(disc: Discovery, run_dir: Path) -> Snapshot:
    snap = run_dir / "snapshot"
    snap.mkdir(mode=0o700, parents=True, exist_ok=True)
    shas = {}
    for rel in disc.included:
        raw = (disc.root / rel).read_bytes()
        shas[rel] = hashlib.sha256(raw).hexdigest()
        dest = snap / rel
        for d in reversed([p for p in dest.parents if snap in p.parents]):
            d.mkdir(mode=0o700, exist_ok=True)
        red, _ = redact_text(raw.decode("utf-8", "surrogateescape"))
        fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(red.encode("utf-8", "surrogateescape"))
        dest.chmod(0o600)
    manifest = hashlib.sha256(json.dumps(sorted(shas.items()), separators=(",", ":")).encode()).hexdigest()
    return Snapshot(snap, shas, manifest)


def read_snapshot(snap: Snapshot, path: str) -> list[str]:
    lines = (snap.dir / path).read_bytes().decode("utf-8", "replace").split("\n")
    if lines[-1] == "":
        lines.pop()
    return [ln.removesuffix("\r") for ln in lines]


def changed_since_snapshot(disc: Discovery, snap: Snapshot) -> list[str]:
    def sha(rel: str) -> str | None:
        try:
            return hashlib.sha256((disc.root / rel).read_bytes()).hexdigest()
        except OSError:
            return None
    return sorted(rel for rel in disc.included if sha(rel) != snap.sha256.get(rel))


@dataclass(frozen=True)
class Options:
    path: Path
    estimate: bool
    dry_run: bool
    status: bool
    max_calls: int | None
    force: bool
    replan: bool
    open: bool
    clean: bool
    unsafe_backend: bool


def parse_args(argv: list[str]) -> Options:
    p = argparse.ArgumentParser(prog="repo-summarize", description=__doc__)
    p.add_argument("path", nargs="?", type=Path, default=Path("."))
    p.add_argument("--estimate", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--status", action="store_true")
    p.add_argument("--max-calls", type=int)
    p.add_argument("--force", action="store_true")
    p.add_argument("--replan", action="store_true")
    p.add_argument("--open", action="store_true")
    p.add_argument("--clean", action="store_true")
    p.add_argument("--unsafe-backend", action="store_true")
    return Options(**vars(p.parse_args(argv)))


def main(argv: list[str]) -> int:
    try:
        parse_args(argv)
    except SystemExit as e:
        if e.code == 0:
            raise
        return EXIT_USAGE
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
