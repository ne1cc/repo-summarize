#!/usr/bin/env bash
# ==============================================================================
# repo-summarize — Headless repository file summarizer for any print-mode AI CLI
#
# Three passes:
#   0. Scan (no AI): build docs/architecture/.repo-map.md — layout, entry points
#      and a heuristic import graph (who imports whom).
#   1. Per file: stream the source plus its repo context (callers, callees,
#      siblings) through an AI CLI (default: agy -p) and write an annotated walkthrough
#      to docs/architecture/<filename>.md — a comment on every line for short
#      files, per-block explanations for long ones.
#   2. Synthesise INDEX.md from the repo map and the per-file summaries.
#
# Usage:
#   repo-summarize                      # summarize current git repository
#   repo-summarize /path/to/repo        # target specific repository
#   repo-summarize --open               # open INDEX.md in a viewer upon finish
#   repo-summarize --dry-run            # scan + show discovered files, no AI calls
#   repo-summarize --max-files N        # process up to N files (default: all)
#   repo-summarize --force              # overwrite existing summaries
#   repo-summarize --filter <substr>    # only process files matching substr
#   repo-summarize --status             # show progress of current / background run
#
# Environment:
#   REPO_SUMMARIZE_CMD   AI command, prompt appended as last arg (default: agy -p)
# ==============================================================================

set -euo pipefail

# AI backend: any CLI that takes the prompt as its last argument and prints the reply.
read -r -a AI_CMD <<< "${REPO_SUMMARIZE_CMD:-agy -p}"

OPEN_IN_OMD=false
DRY_RUN=false
FORCE=false
CHECK_STATUS=false
MAX_FILES=0   # 0 = no cap (process all files)
TARGET_DIR=""
FILTER=""

usage() {
  sed -n '2,26p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--open) OPEN_IN_OMD=true; shift ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    -f|--force) FORCE=true; shift ;;
    -s|--status) CHECK_STATUS=true; shift ;;
    -m|--max-files)
      MAX_FILES="${2:-0}"
      shift 2
      ;;
    --filter)
      FILTER="${2:-}"
      shift 2
      ;;
    -h|--help) usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "$TARGET_DIR" ]]; then
        TARGET_DIR="$1"
        shift
      else
        echo "Unexpected argument: $1" >&2
        usage 1
      fi
      ;;
  esac
done

# Resolve target directory
if [[ -z "$TARGET_DIR" ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    TARGET_DIR="$(git rev-parse --show-toplevel)"
  else
    TARGET_DIR="$(pwd)"
  fi
else
  TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
fi

cd "$TARGET_DIR"
REPO_NAME="$(basename "$TARGET_DIR")"
DOCS_DIR="$TARGET_DIR/docs/architecture"
INDEX_FILE="$DOCS_DIR/INDEX.md"
PROGRESS_FILE="$DOCS_DIR/.progress.json"

# Fast path: query status of running / last summarization
if "$CHECK_STATUS"; then
  if [[ ! -f "$PROGRESS_FILE" ]]; then
    existing_count=$(find "$DOCS_DIR" -name "*.md" ! -name "INDEX.md" 2>/dev/null | wc -l | tr -d ' ')
    echo "No active .progress.json in $DOCS_DIR."
    echo "Generated architecture docs: $existing_count files."
    exit 0
  fi

  if command -v jq >/dev/null 2>&1; then
    st="$(jq -r .status "$PROGRESS_FILE")"
    tot="$(jq -r .total_files "$PROGRESS_FILE")"
    proc="$(jq -r .processed "$PROGRESS_FILE")"
    pct="$(jq -r .percent "$PROGRESS_FILE")"
    cur="$(jq -r .current_file "$PROGRESS_FILE")"
    upd="$(jq -r .updated_at "$PROGRESS_FILE")"
    
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo " 📊 Repo Summarize Progress: $REPO_NAME"
    echo " Status    : $st"
    echo " Progress  : $proc / $tot files ($pct%)"
    echo " Current   : $cur"
    echo " Updated   : $upd"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  else
    cat "$PROGRESS_FILE"
  fi
  exit 0
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " 📚 Headless Repo Summarizer (${AI_CMD[*]})"
echo " Target : $TARGET_DIR"
echo " Docs   : docs/architecture/"
echo " Limit  : ${MAX_FILES:-no cap}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

mkdir -p "$DOCS_DIR"

# Discover files using fd or git ls-files
find_files() {
  if command -v fd >/dev/null 2>&1; then
    fd -t f \
      -E ".git" \
      -E "node_modules" \
      -E ".venv" \
      -E "venv" \
      -E "__pycache__" \
      -E ".worktrees" \
      -E "dist" \
      -E "build" \
      -E "target" \
      -E "vendor" \
      -E "coverage" \
      -E ".next" \
      -E ".turbo" \
      -E "third-party" \
      -E "lazy-lock.json" \
      -E "package-lock.json" \
      -E "yarn.lock" \
      -E "pnpm-lock.yaml" \
      -E "poetry.lock" \
      -E "uv.lock" \
      -E "Cargo.lock" \
      -E "Gemfile.lock" \
      -E "*.min.js" \
      -E "*.min.css" \
      -E "*.map" \
      -E "*.svg" \
      -E "*.png" \
      -E "*.jpg" \
      -E "*.jpeg" \
      -E "*.gif" \
      -E "*.ico" \
      -E "*.woff*" \
      -E "*.ttf" \
      -E "docs/architecture/*" \
      -E "docs/explanations/*" \
      -e py -e ts -e tsx -e js -e jsx \
      -e go -e rs -e lua -e sh -e zsh \
      -e sql -e cpp -e c -e h -e hpp \
      -e java -e cmake -e kt -e swift \
      . "$TARGET_DIR"
  elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files \
      | grep -E '\.(py|ts|tsx|js|jsx|go|rs|lua|sh|zsh|sql|cpp|c|h|hpp|java|cmake|kt|swift)$' \
      | grep -vE '(node_modules|\.venv|dist/|build/|target/|third-party/|docs/architecture/|docs/explanations/)'
  else
    find . -type f \( \
      -name "*.py" -o -name "*.ts" -o -name "*.js" -o -name "*.go" \
      -o -name "*.rs" -o -name "*.lua" -o -name "*.sh" \
      -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" -o -name "*.c" \
    \) | sed 's|^\./||'
  fi
}

# Collect candidate files. MAP_FILES stays unfiltered so the repo map still sees
# callers/callees outside --filter; ALL_CANDIDATES is what gets summarized.
MAP_FILES=()
ALL_CANDIDATES=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  rel_path="${f#"$TARGET_DIR"/}"
  rel_path="${rel_path#./}"
  MAP_FILES+=("$rel_path")

  if [[ -n "$FILTER" ]] && [[ "$rel_path" != *"$FILTER"* ]]; then
    continue
  fi
  ALL_CANDIDATES+=("$rel_path")
done < <(find_files)

if [[ ${#ALL_CANDIDATES[@]} -eq 0 ]]; then
  echo "No relevant code files discovered under $TARGET_DIR."
  exit 0
fi

# ---------------------------------------------------------------------------
# Smart scoring: ensures directory breadth coverage across ALL top-level dirs.
#
# Bash 3.2 compatible (macOS default). Uses awk for the round-robin grouping
# instead of bash 4 associative arrays.
#
# Strategy:
#   1. Emit "score<TAB>top_dir<TAB>filepath" for every candidate
#   2. awk groups by top_dir, sorts within each group by score, then round-robins
#      across directories so every module gets at least one representative file
#      before any module gets a second.
# ---------------------------------------------------------------------------
score_file_line() {
  local p="$1"
  local base top_dir score
  base="$(basename "$p")"
  top_dir="${p%%/*}"
  [[ "$top_dir" == "$p" ]] && top_dir="."

  if [[ "$base" == "CMakeLists.txt" ]] || \
     [[ "$base" =~ ^(main|app|index|server|cli|setup|init|entry)\. ]]; then
    score=10
  elif [[ "$p" =~ tests?/ ]] || [[ "$base" =~ _test\. ]] || \
       [[ "$base" =~ \.test\. ]] || [[ "$base" =~ _spec\. ]]; then
    score=80
  else
    score=50
  fi
  printf '%d\t%s\t%s\n' "$score" "$top_dir" "$p"
}

# Build scored list then round-robin in awk (no bash 4 / no gawk needed)
# Approach:
#   1. Emit "score<TAB>top_dir<TAB>filepath" lines
#   2. sort by top_dir then score → groups are contiguous per dir
#   3. awk picks one file per dir per pass (round-robin) using SUBSEP separator
SORTED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && SORTED_FILES+=("$line")
done < <(
  for f in "${ALL_CANDIDATES[@]}"; do
    score_file_line "$f"
  done \
  | sort -t$'\t' -k2,2 -k1,1n -k3,3 \
  | awk -F'\t' '
  {
    dir = $2
    file = $3
    # Store files per-dir as SUBSEP-separated list (POSIX awk safe)
    if (bucket[dir] == "") {
      ndirs++
      dir_order[ndirs] = dir
    }
    bucket[dir] = (bucket[dir] == "") ? file : (bucket[dir] SUBSEP file)
  }
  END {
    any = 1
    while (any) {
      any = 0
      # Iterate dirs in sorted order (already pre-sorted by the shell sort above)
      for (i = 1; i <= ndirs; i++) {
        d = dir_order[i]
        if (bucket[d] != "") {
          any = 1
          pos = index(bucket[d], SUBSEP)
          if (pos > 0) {
            print substr(bucket[d], 1, pos - 1)
            bucket[d] = substr(bucket[d], pos + 1)
          } else {
            print bucket[d]
            bucket[d] = ""
          }
        }
      }
    }
  }
'
)

# Apply MAX_FILES cap only if explicitly set
FILES_TO_PROCESS=()
if [[ ${#SORTED_FILES[@]} -gt 0 ]]; then
  if [[ "$MAX_FILES" -gt 0 ]]; then
    FILES_TO_PROCESS=("${SORTED_FILES[@]:0:$MAX_FILES}")
  else
    FILES_TO_PROCESS=("${SORTED_FILES[@]}")
  fi
fi

echo "Discovered ${#ALL_CANDIDATES[@]} candidate files. Processing ${#FILES_TO_PROCESS[@]} for summarization:"
for f in "${FILES_TO_PROCESS[@]+"${FILES_TO_PROCESS[@]}"}"; do
  echo "  • $f"
done
echo ""

# ---------------------------------------------------------------------------
# Pass 0 — zero-AI repo scan
#
# Builds docs/architecture/.repo-map.md (layout, entry points, import graph,
# per-file line counts) and .repo-edges.tsv ("importer<TAB>imported" pairs).
# Every per-file prompt below is enriched from these, so no file is explained
# in isolation. Import resolution is heuristic: py, js/ts, lua, sh/zsh and
# c/c++ only; ambiguous or external imports are dropped rather than guessed.
# ---------------------------------------------------------------------------
MAP_FILE="$DOCS_DIR/.repo-map.md"
EDGES_FILE="$DOCS_DIR/.repo-edges.tsv"
ERR_LOG="$DOCS_DIR/.repo-summarize.log"
DOC_MARKER="repo-summarize:v2"
ANNOTATE_LINE_LIMIT=150     # <= this many lines: comment every line; above: per-block
PROMPT_BYTE_LIMIT=110000    # the AI CLI takes the prompt as ONE argv entry (Linux caps it at ~128KB)

WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/repo-summarize.XXXXXX")"
trap 'rm -rf "$WORK_DIR"' EXIT
printf '%s\n' "${FILES_TO_PROCESS[@]+"${FILES_TO_PROCESS[@]}"}" > "$WORK_DIR/process.txt"

# Print the module specifiers a file imports, one per line.
extract_imports() {
  local rel="$1" path="$TARGET_DIR/$1" q="['\"]"
  case "${rel##*.}" in
    py)
      sed -nE -e 's/^[[:space:]]*from[[:space:]]+([._[:alnum:]]+)[[:space:]]+import.*/\1/p' \
              -e 's/^[[:space:]]*import[[:space:]]+([._[:alnum:]]+).*/\1/p' "$path" ;;
    js|jsx|ts|tsx)
      sed -nE -e "s/.*(from|require\(|import\()[[:space:]]*$q([^'\"]+)$q.*/\2/p" \
              -e "s/^[[:space:]]*import[[:space:]]+$q([^'\"]+)$q.*/\1/p" "$path" ;;
    lua)
      sed -nE "s/.*require[[:space:]]*\(?[[:space:]]*$q([^'\"]+)$q.*/\1/p" "$path" ;;
    sh|zsh)
      sed -nE "s/^[[:space:]]*(source|\.)[[:space:]]+$q?([^'\" ;]+).*/\2/p" "$path" ;;
    c|h|cpp|hpp)
      sed -nE 's/^[[:space:]]*#[[:space:]]*include[[:space:]]*"([^"]+)".*/\1/p' "$path" ;;
  esac
}

# Resolve raw "file<TAB>specifier" pairs to "file<TAB>repo-path" edges.
# Relative specifiers resolve exactly; bare ones match a unique path suffix.
resolve_edges() {
  awk -F'\t' '
    function dirname(p) { return (sub(/\/[^\/]*$/, "", p)) ? p : "" }
    function normalize(p,   n, parts, i, k, stack, out) {
      n = split(p, parts, "/"); k = 0
      for (i = 1; i <= n; i++) {
        if (parts[i] == "" || parts[i] == ".") continue
        if (parts[i] == "..") { if (k > 0) k--; continue }
        stack[++k] = parts[i]
      }
      out = ""
      for (i = 1; i <= k; i++) out = out (i > 1 ? "/" : "") stack[i]
      return out
    }
    function addkey(k, p,   n, parts, i, s) {
      if (!(k in exact)) exact[k] = p
      n = split(k, parts, "/"); s = ""
      for (i = n; i >= 1; i--) {
        s = (s == "") ? parts[i] : parts[i] "/" s
        if ((s in suffix) && suffix[s] != p) amb[s] = 1
        else suffix[s] = p
      }
    }
    NR == FNR {
      p = $0; noext = p; sub(/\.[^.\/]+$/, "", noext)
      addkey(noext, p); addkey(p, p)
      if (noext ~ /(^|\/)(index|__init__|init|mod)$/) {
        d = noext; sub(/\/?(index|__init__|init|mod)$/, "", d)
        if (d != "") addkey(d, p)
      }
      next
    }
    {
      f = $1; spec = $2; target = ""
      ext = f; sub(/^.*\./, "", ext)
      if (spec ~ /^\.\.?\//) {
        key = normalize(dirname(f) "/" spec)
        if (key in exact) target = exact[key]
      } else if (ext == "py" && spec ~ /^\./) {
        n = match(spec, /[^.]/); lead = (n == 0) ? length(spec) : n - 1
        rest = (n == 0) ? "" : substr(spec, n); gsub(/\./, "/", rest)
        base = dirname(f)
        for (i = 1; i < lead; i++) base = dirname(base)
        if (rest != "") { key = normalize(base "/" rest); if (key in exact) target = exact[key] }
      } else if (ext == "py" || ext == "lua") {
        key = spec; gsub(/\./, "/", key)
        if ((key in suffix) && !(key in amb)) target = suffix[key]
      } else if (ext ~ /^(js|jsx|ts|tsx)$/) {
        if (spec ~ /^[@~]\//) { key = substr(spec, 3); if ((key in suffix) && !(key in amb)) target = suffix[key] }
      } else {
        key = spec; if (key ~ /\$/) sub(/^.*\//, "", key)
        if ((key in suffix) && !(key in amb)) target = suffix[key]
      }
      if (target != "" && target != f && !((f SUBSEP target) in seen)) {
        seen[f SUBSEP target] = 1
        print f "\t" target
      }
    }
  ' "$1" "$2"
}

build_repo_map() {
  local files_list="$WORK_DIR/files.txt" raw="$WORK_DIR/raw-edges.tsv" rel
  printf '%s\n' "${MAP_FILES[@]}" > "$files_list"

  : > "$raw"
  for rel in "${MAP_FILES[@]}"; do
    extract_imports "$rel" 2>/dev/null | awk -v f="$rel" '{ print f "\t" $0 }' >> "$raw" || true
  done
  resolve_edges "$files_list" "$raw" | LC_ALL=C sort -u > "$EDGES_FILE"

  # Top-level layout + entry points are reused verbatim inside every file prompt.
  awk '{ d = index($0, "/") ? substr($0, 1, index($0, "/") - 1) : "."; n[d]++ }
       END { for (d in n) printf "- `%s` — %d files\n", d, n[d] }' "$files_list" \
    | LC_ALL=C sort > "$WORK_DIR/layout.txt"
  for rel in "${MAP_FILES[@]}"; do score_file_line "$rel"; done \
    | awk -F'\t' '$1 == 10 { print "- `" $3 "`" }' > "$WORK_DIR/entry.txt"

  {
    echo "# Repo map: $REPO_NAME"
    echo
    echo "> Generated $(date +"%Y-%m-%d %H:%M:%S") by \`repo-summarize\` (zero-AI scan)."
    echo "> Import edges are heuristic (py, js/ts, lua, sh/zsh, c/c++); ambiguous or external imports are omitted."
    echo
    echo "## Top-level layout"
    echo
    cat "$WORK_DIR/layout.txt"
    echo
    echo "## Entry points"
    echo
    cat "$WORK_DIR/entry.txt"
    echo
    echo "## Import edges"
    echo
    echo '```text'
    awk -F'\t' '{ print $1 " -> " $2 }' "$EDGES_FILE"
    echo '```'
    echo
    echo "## Files"
    echo
    echo "| File | Lines | Imports | Imported by |"
    echo "|---|---|---|---|"
    (cd "$TARGET_DIR" && tr '\n' '\0' < "$files_list" | xargs -0 wc -l 2>/dev/null) \
      | awk -v edges="$EDGES_FILE" '
          BEGIN {
            FS = "\t"
            while ((getline l < edges) > 0) { split(l, a, "\t"); outc[a[1]]++; inc[a[2]]++ }
            FS = " "
          }
          /^ *[0-9]+ total$/ { next }
          { n = $1; sub(/^ *[0-9]+ /, ""); printf "| `%s` | %d | %d | %d |\n", $0, n, outc[$0] + 0, inc[$0] + 0 }
        ' | LC_ALL=C sort
  } > "$MAP_FILE"
}

build_repo_map
echo "Repo map: ${MAP_FILE#"$TARGET_DIR"/} (${#MAP_FILES[@]} files, $(grep -c '' "$EDGES_FILE") import edges)"
echo ""

if "$DRY_RUN"; then
  echo "Dry-run complete. Exiting without generating summaries."
  exit 0
fi

if ! command -v "${AI_CMD[0]}" >/dev/null 2>&1; then
  echo "Error: '${AI_CMD[0]}' not found in PATH. Install it or set REPO_SUMMARIZE_CMD (e.g. 'claude -p')." >&2
  exit 1
fi

INDEX_ENTRIES=()
TOTAL_FILES=${#FILES_TO_PROCESS[@]}
CURRENT_INDEX=0

write_progress() {
  local status="$1"
  local current_file="$2"
  local pct=0
  if [[ "$TOTAL_FILES" -gt 0 ]]; then
    pct=$(( CURRENT_INDEX * 100 / TOTAL_FILES ))
  fi
  cat <<EOF > "$PROGRESS_FILE"
{
  "status": "$status",
  "total_files": $TOTAL_FILES,
  "processed": $CURRENT_INDEX,
  "percent": $pct,
  "current_file": "$current_file",
  "updated_at": "$(date +"%Y-%m-%d %H:%M:%S")"
}
EOF
}
# ---------------------------------------------------------------------------
# Pass 1 — per-file annotated walkthrough
# ---------------------------------------------------------------------------
FAILED_FILES=()
: > "$ERR_LOG"

fail_file() {
  echo "  ✗ [$CURRENT_INDEX/$TOTAL_FILES] Failed: $1 ($2) — see ${ERR_LOG#"$TARGET_DIR"/}"
  printf '[%s] %s: %s\n' "$(date +"%Y-%m-%d %H:%M:%S")" "$1" "$2" >> "$ERR_LOG"
  FAILED_FILES+=("$1")
}

callees() { awk -F'\t' -v f="$1" '$1 == f { print $2 }' "$EDGES_FILE"; }
callers() { awk -F'\t' -v f="$1" '$2 == f { print $1 }' "$EDGES_FILE"; }

comment_prefix() {
  case "$1" in
    py|sh|zsh|cmake) echo '#' ;;
    lua|sql) echo '--' ;;
    *) echo '//' ;;
  esac
}

# "../" repeated once per directory level of $1 (docs/architecture/<rel>.md → docs/architecture/).
rel_up() {
  local d up=""
  d="$(dirname "$1")"
  while [[ "$d" != "." && "$d" != "/" ]]; do up+="../"; d="$(dirname "$d")"; done
  printf '%s' "$up"
}

# Link to a dependency's doc when it exists or is about to be generated.
doc_link() {
  local up
  up="$(rel_up "$1")"
  if [[ -f "$DOCS_DIR/$2.md" ]] || grep -Fxq -- "$2" "$WORK_DIR/process.txt"; then
    printf -- '- [`%s`](%s%s.md)\n' "$2" "$up" "$2"
  else
    printf -- '- `%s`\n' "$2"
  fi
}

# Deterministic "Related Files" footer — built from the scan, not from the model.
related_block() {
  local rel="$1" dep any
  printf '## Related Files\n\n**Imports** (heuristic scan)\n\n'
  any=false
  while IFS= read -r dep; do
    [[ -z "$dep" ]] && continue
    any=true; doc_link "$rel" "$dep"
  done < <(callees "$rel")
  "$any" || printf -- '- none detected\n'
  printf '\n**Imported by**\n\n'
  any=false
  while IFS= read -r dep; do
    [[ -z "$dep" ]] && continue
    any=true; doc_link "$rel" "$dep"
  done < <(callers "$rel")
  "$any" || printf -- '- none detected\n'
}

# Print the full prompt for one file. $2 = line count, $3 = line|block,
# $4 = true|false (include head-of-file excerpts of imported files).
build_file_prompt() {
  local rel="$1" n_lines="$2" mode="$3" with_excerpts="$4"
  local ext="${rel##*.}" fence='```' src="$TARGET_DIR/$1"
  local cp overview="" cand dep i=0 siblings imports_ctx="" dependents source_block format_spec rules

  cp="$(comment_prefix "$ext")"

  for cand in AGENTS.md CLAUDE.md README.md; do
    if [[ -f "$TARGET_DIR/$cand" ]]; then overview="$(sed -n '1,40p' "$TARGET_DIR/$cand")"; break; fi
  done

  [[ -z "$overview" ]] && overview="(no AGENTS.md, CLAUDE.md or README.md found)"

  siblings="$(awk -v d="$(dirname "$rel")" '
    { p = $0; if (!sub(/\/[^\/]*$/, "", p)) p = "."; if (p == d) print "- " $0 }
  ' "$WORK_DIR/files.txt" | head -20)"

  while IFS= read -r dep; do
    [[ -z "$dep" ]] && continue
    i=$(( i + 1 ))
    imports_ctx+="- $dep"$'\n'
    if [[ "$with_excerpts" == "true" && $i -le 6 && -s "$TARGET_DIR/$dep" ]]; then
      imports_ctx+="~~~~${dep##*.}"$'\n'"$(sed -n '1,25p' "$TARGET_DIR/$dep")"$'\n'"~~~~"$'\n'
    fi
  done < <(callees "$rel" | head -20)
  [[ -z "$imports_ctx" ]] && imports_ctx="(none detected)"

  dependents="$(callers "$rel" | head -15 | sed 's/^/- /')"
  [[ -z "$dependents" ]] && dependents="(none detected)"

  read -r -d '' rules <<EOS || true
Rules:
- Ground every statement in the source or the context above. If something cannot be determined from them (for example the behaviour of a file that is not shown), write "unknown" instead of guessing.
- Do not invent callers, callees, flags, or behaviour.
- Draw every diagram (architecture, data flow, sequence, state, dependency tree) as Mermaid in its own ${fence}mermaid block. Never use ASCII or box-drawing art. Quote node labels that contain punctuation, e.g. A["load()"]. Never use a Mermaid keyword (end, off, alt, opt, loop, par, graph) as a node or participant ID.
- Output ONLY the Markdown sections specified above. No preamble, no closing remarks, and do not wrap the whole document in one code block.
EOS

  if [[ "$mode" == "line" ]]; then
    source_block="$(cat "$src")"
    read -r -d '' format_spec <<EOS || true
The file is short ($n_lines lines), so annotate EVERY line. Produce exactly these three sections with these exact headings:

## Summary
2-4 sentences: what the file does, why it exists, and its role in this repository, referring to the imports and dependents above where relevant.

## Annotated Source
One ${fence}${ext} code block containing the COMPLETE source, in original order, reproduced verbatim. Directly above EVERY non-blank source line, add one explanatory comment line in this language's comment syntax ($cp), beginning with "$cp » ". Annotation rules:
- Explain what the line does AND why it is there; do not just restate the syntax.
- Name the specific variables, functions, flags, and values involved.
- Never modify, reorder, or drop a source line. Blank lines and existing comments stay as they are.
- Always place annotations on their own line ABOVE the code, never trailing, so line continuations, heredocs, and multi-line strings keep working.
- For a closing line (brace, end, fi, done, esac), say which construct it closes.

## Invariants, Edge Cases & Gotchas
Bullets covering assumptions the code makes about its callers or environment, failure modes, error handling, side effects, and anything a maintainer could trip over.
EOS
  else
    source_block="$(awk '{ printf "%5d  %s\n", NR, $0 }' "$src")"
    read -r -d '' format_spec <<EOS || true
The file is long ($n_lines lines), so explain it block by block. The source above carries line-number prefixes for reference only. Produce exactly these three sections with these exact headings:

## Summary
2-4 sentences: what the file does, why it exists, and its role in this repository, referring to the imports and dependents above where relevant.

## Walkthrough
Split the source into consecutive logical blocks (a function, a class, an import section, a config section, ...) of roughly 5-40 lines that together cover EVERY line exactly once, with no gaps and no overlaps. For each block output:
### Lines A-B: short title
A ${fence}${ext} code block with the block reproduced verbatim (line-number prefixes removed), then a paragraph or bullets explaining, in order, what each notable statement does and why: parameters, return values, side effects, error handling, and how it connects to other files.

## Invariants, Edge Cases & Gotchas
Bullets covering assumptions the code makes about its callers or environment, failure modes, error handling, side effects, and anything a maintainer could trip over.
EOS
  fi

  cat <<EOF
You are a senior principal engineer writing the definitive explanation of one source file for a teammate who has never seen this repository.

## Repository context
Repository: $REPO_NAME

Project overview (top of its docs):
~~~~markdown
$overview
~~~~

Top-level layout:
$(cat "$WORK_DIR/layout.txt")

Entry points:
$(cat "$WORK_DIR/entry.txt")

## Target file: $rel ($n_lines lines)
Other files in the same directory:
$siblings

Imports (this file depends on; head of each shown when available):
$imports_ctx

Imported by:
$dependents

The import data above comes from a heuristic scan and may be incomplete.

## Source
~~~~$ext
$source_block
~~~~

## Output format
$format_spec

$rules
EOF
}

# Make Mermaid diagrams render: a fence that is untagged, tagged text, or tagged
# with a diagram keyword (```flowchart, ```mmd) is retagged ```mermaid when its
# first statement is a Mermaid header; a bare Mermaid diagram outside any fence
# is wrapped in one, ending at the next blank line or heading. Code fences in a
# real language are never touched, and stdin → stdout is otherwise verbatim.
wrap_mermaid() {
  awk '
    function header(s) {
      sub(/^[ \t]+/, "", s); sub(/[ \t;]+$/, "", s)
      return s ~ /^(graph|flowchart)[ \t]+(TD|TB|BT|RL|LR)$/ ||
             s ~ /^(sequenceDiagram|classDiagram(-v2)?|stateDiagram(-v2)?|erDiagram|journey|gantt|pie|mindmap|timeline|gitGraph|quadrantChart|requirementDiagram|kanban|C4(Context|Container|Component|Dynamic|Deployment)|(sankey|xychart|block|packet|architecture)-beta)([ \t].*)?$/
    }
    function indent(s) { match(s, /^[ \t]*/); return RLENGTH }
    function flush(tag,   i) {
      print (tag ? pad mark "mermaid" : buf[0])
      for (i = 1; i < nbuf; i++) print buf[i]
      nbuf = 0; pending = 0
    }
    {
      line = $0; t = line; sub(/^[ \t]+/, "", t)
      if (pending) {
        buf[nbuf++] = line
        if (t == "" || t ~ /^%%/) next
        if (t ~ "^" mark) { flush(0); fence = ""; next }
        flush(header(line)); next
      }
      if (fence != "") {
        print line
        if (t ~ "^" fence substr(fence, 1, 1) "*[ \t]*$") fence = ""
        next
      }
      if (unfenced) {
        if (t == "" || t ~ /^#/ || t ~ /^(```|~~~)/) { print pad "```"; unfenced = 0 }
        else { print line; next }
      }
      if (indent(line) < 4 && match(t, /^(```+|~~~+)/)) {
        mark = substr(t, 1, RLENGTH); fence = mark
        info = substr(t, RLENGTH + 1); sub(/^[ \t]+/, "", info); sub(/[ \t]+$/, "", info)
        pad = substr(line, 1, indent(line))
        if (header(info)) { print pad mark "mermaid"; print pad info; next }
        if (info ~ /^(text|txt|plaintext|ascii|mmd)?$/) {
          nbuf = 0; buf[nbuf++] = line; pending = 1; next
        }
        print line; next
      }
      if (indent(line) < 4 && header(line)) {
        pad = substr(line, 1, indent(line))
        print pad "```mermaid"; print line; unfenced = 1; next
      }
      print line
    }
    END {
      if (pending) flush(0)
      if (unfenced) print pad "```"
    }
  '
}

for rel in "${FILES_TO_PROCESS[@]+"${FILES_TO_PROCESS[@]}"}"; do
  CURRENT_INDEX=$(( CURRENT_INDEX + 1 ))
  doc_rel="docs/architecture/${rel}.md"
  doc_full="$TARGET_DIR/$doc_rel"
  src="$TARGET_DIR/$rel"
  mkdir -p "$(dirname "$doc_full")"

  if [[ ! -s "$src" ]]; then
    echo "⏩ [$CURRENT_INDEX/$TOTAL_FILES] Skip: $rel (empty file)"
    write_progress "running" "$rel (empty)"
    continue
  fi

  # Cached only if the doc is v2-format and not older than its source.
  if [[ "$FORCE" != "true" && -f "$doc_full" && ! "$src" -nt "$doc_full" ]] \
     && grep -qF "$DOC_MARKER" "$doc_full"; then
    echo "⏩ [$CURRENT_INDEX/$TOTAL_FILES] Skip: $rel (up to date)"
    write_progress "running" "$rel (cached)"
    INDEX_ENTRIES+=("$rel")
    continue
  fi

  n_lines="$(grep -c '' "$src")"
  if (( n_lines <= ANNOTATE_LINE_LIMIT )); then mode="line"; else mode="block"; fi

  echo "🧠 [$CURRENT_INDEX/$TOTAL_FILES] Summarizing: $rel ($n_lines lines, $mode mode) → $doc_rel ..."
  write_progress "running" "$rel"

  tmp_prompt="$WORK_DIR/prompt.txt"
  build_file_prompt "$rel" "$n_lines" "$mode" true > "$tmp_prompt"
  if (( $(wc -c < "$tmp_prompt") > PROMPT_BYTE_LIMIT )); then
    build_file_prompt "$rel" "$n_lines" "$mode" false > "$tmp_prompt"
  fi
  if (( $(wc -c < "$tmp_prompt") > PROMPT_BYTE_LIMIT )); then
    fail_file "$rel" "prompt exceeds ${PROMPT_BYTE_LIMIT} bytes even without dependency excerpts"
    continue
  fi

  if RESPONSE="$("${AI_CMD[@]}" "$(cat "$tmp_prompt")" 2>>"$ERR_LOG")" && [[ "$RESPONSE" =~ [^[:space:]] ]]; then
    RESPONSE="$(printf '%s\n' "$RESPONSE" | wrap_mermaid)"
  else
    fail_file "$rel" "${AI_CMD[0]} exited non-zero or returned empty output"
    continue
  fi

  up="$(rel_up "$rel")"
  cat <<EOF > "$doc_full"
<!-- $DOC_MARKER -->
# Architecture Summary: \`$rel\`

> **Source File**: [\`$rel\`](${up}../../$rel)
> **Repository**: \`$REPO_NAME\`
> **Style**: $mode-by-$mode annotation ($n_lines lines)
> **Generated**: $(date +"%Y-%m-%d %H:%M:%S") via \`repo-summarize\` + \`${AI_CMD[0]}\`

---

$RESPONSE

---

$(related_block "$rel")
EOF

  INDEX_ENTRIES+=("$rel")
  echo "  ✓ [$CURRENT_INDEX/$TOTAL_FILES] Saved: $doc_rel"
done

# ---------------------------------------------------------------------------
# Generate INDEX.md — AI-synthesised architectural overview
# ---------------------------------------------------------------------------
echo ""
echo "🏗️  Generating architectural INDEX.md (AI synthesis of all summaries)..."
write_progress "synthesizing_index" "INDEX.md"

# Feed each file's "## Summary" section (not the full annotated source) into the
# INDEX synthesis, so the context stays small enough for one prompt.
ALL_SUMMARIES=""
for rel in "${INDEX_ENTRIES[@]+"${INDEX_ENTRIES[@]}"}"; do
  doc_full="$TARGET_DIR/docs/architecture/${rel}.md"
  if [[ -f "$doc_full" ]]; then
    summary="$(awk '/^## Summary/ { f = 1; next } /^## / { f = 0 } f' "$doc_full")"
    [[ -z "$summary" ]] && summary="$(sed -n '1,12p' "$doc_full")"
    ALL_SUMMARIES+="
=== $rel ===
$summary

"
  fi
done
# The prompt is a single argv entry (see PROMPT_BYTE_LIMIT); keep summaries within budget.
if (( ${#ALL_SUMMARIES} > 55000 )); then
  ALL_SUMMARIES="${ALL_SUMMARIES:0:55000}
(summaries truncated to fit the prompt limit)"
fi

tmp_index_prompt="$WORK_DIR/index-prompt.txt"
cat <<EOF > "$tmp_index_prompt"
You are a principal architect synthesising documentation for the repository '$REPO_NAME'.

Below is a zero-AI repo map (layout, entry points, heuristic import edges, line counts), followed by a short summary of every key source file in the project.

Repo map:
$(head -n 500 "$MAP_FILE")

Your task: write a comprehensive INDEX.md that:
1. **Big Picture Overview** — What is '$REPO_NAME'? What problem does it solve? Who uses it?
2. **Module Map** — A Mermaid flowchart (flowchart TD) showing top-level directories and their relationships/dependencies. Derive edges from the repo map's import edges; do not invent dependencies it does not show.
3. **Directory Breakdown** — For each top-level directory, one paragraph explaining its role and key files inside it.
4. **Core Data Flows** — The most important 2-3 end-to-end flows through the codebase (e.g. "a DNS query arrives → ...").
5. **Key Abstractions** — The 5-10 most important types, interfaces, or design patterns that everything else builds on.
6. **File Index** — A markdown table with columns: File | Role | Key Exports linking to each .md doc using relative path docs/architecture/<file>.md.

Per-file summaries:
$ALL_SUMMARIES

Draw every diagram as Mermaid in its own \`\`\`mermaid block, never ASCII or box-drawing art, and quote node labels that contain punctuation. Never use a Mermaid keyword (end, off, alt, opt, loop, par, graph) as a node or participant ID.

Write in clean GitHub-Flavored Markdown. Make this the definitive architectural reference for a new engineer joining the project.
EOF

if ! INDEX_RESPONSE="$("${AI_CMD[@]}" "$(cat "$tmp_index_prompt")" 2>>"$ERR_LOG")" || [[ ! "$INDEX_RESPONSE" =~ [^[:space:]] ]]; then
  write_progress "index_failed" "INDEX.md"
  echo "✗ INDEX synthesis failed — existing INDEX.md left untouched. See ${ERR_LOG#"$TARGET_DIR"/}" >&2
  exit 1
fi
INDEX_RESPONSE="$(printf '%s\n' "$INDEX_RESPONSE" | wrap_mermaid)"

cat <<EOF > "$INDEX_FILE"
# $REPO_NAME — Architectural Overview

> Generated on $(date +"%Y-%m-%d %H:%M:%S") by [\`repo-summarize\`](https://github.com/ne1cc/repo-summarize) + \`${AI_CMD[0]}\`
> Per-file summaries are in \`docs/architecture/<path>.md\`

---

$INDEX_RESPONSE
EOF

if [[ ${#FAILED_FILES[@]} -gt 0 ]]; then
  write_progress "complete_with_errors" "INDEX.md"
else
  write_progress "complete" "INDEX.md"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ ${#FAILED_FILES[@]} -gt 0 ]]; then
  echo "⚠ Summaries generated with ${#FAILED_FILES[@]} failure(s):"
  printf '    ✗ %s\n' "${FAILED_FILES[@]}"
  echo "  Re-run to retry only the failed files (finished ones are cached)."
else
  echo "✓ All summaries generated!"
fi
echo "  Index  : $INDEX_FILE"
echo "  Files  : ${#INDEX_ENTRIES[@]} summarized → docs/architecture/"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if "$OPEN_IN_OMD"; then
  if command -v omd >/dev/null 2>&1; then
    echo "Opening $INDEX_FILE in One Markdown..."
    omd "$INDEX_FILE"
  elif [[ "$OSTYPE" == darwin* ]]; then
    open -a "One Markdown" "$INDEX_FILE" 2>/dev/null || open "$INDEX_FILE"
  else
    glow -p "$INDEX_FILE" 2>/dev/null || xdg-open "$INDEX_FILE" 2>/dev/null || true
  fi
fi
