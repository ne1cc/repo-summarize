#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""repo-summarize: turn a repo into a short book of Markdown docs."""
import argparse
import fnmatch
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_ABORT, EXIT_CAPPED, EXIT_UNSAFE = 0, 1, 2, 3, 4, 5

PROMPT_LIMIT = 110_000
BATCH_BYTES = 60_000
FILE_LINES = 400
CONDENSE_BYTES = 80_000
MAX_FILE = 100_000
BINARY_PROBE = 8192
BUDGET_INSTR = 8_000
BUDGET_CATALOG = 12_000
BUDGET_TESTS = 4_000
REPLY_LIMIT = 64_000
MAX_REFS = 8
REF_MIN = 5
REF_MAX = 40
IDENT_WINDOW = 5
SHIM_RATIO = 0.8
MAX_CHAPTERS = 12
TIMEOUT = 300
BREAKER = 3
KEEP_RUNS = 3
EDGE_JACCARD = 0.20
NEW_FILES_RATIO = 0.10
RELATED_MAX = 3
DEFAULT_CMD = "agy --disable-slash-commands -p"
MARKER = "repo-summarize:v3"


# --- discover ---------------------------------------------------------------

SKIP_REASONS = ("symlink", "unsafe-path", "binary", "too-large", "lockfile", "minified",
                "generated-docs", "secret-file", "unsupported-type")
CODE_EXTS = {".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".lua", ".sh", ".zsh", ".sql", ".cpp", ".c",
             ".h", ".hpp", ".java", ".cmake", ".kt", ".swift", ".yml", ".yaml", ".toml", ".json",
             ".properties", ".ini", ".cfg"}
LOCKFILES = {"package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb", "Cargo.lock", "go.sum", "poetry.lock"}
ENV_SAFE = {".env.example", ".env.sample", ".env.template"}
SECRET_GLOBS = ("*.pem", "*.key", "*.p12", "*id_rsa*", "*credentials*.json")
UNSAFE_PATH = re.compile(r"[\x00-\x1f\x7f`|]")
SHEBANG = re.compile(rb"#!.*\b(bash|sh|zsh|python\d*|node|ruby|perl)\b")


@dataclass
class Discovery:
    root: Path
    discovered: list[str]
    included: list[str]
    skipped: dict[str, list[str]]


def _list_files(root: Path) -> list[str]:
    git = subprocess.run(["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
                         capture_output=True)
    if git.returncode == 0:
        return sorted(set(git.stdout.decode(errors="surrogateescape").split("\0")) - {""})
    out = []
    for dp, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d != ".git"]
        out += [os.path.relpath(os.path.join(dp, n), root) for n in names]
    return sorted(out)


def _skip_reason(root: Path, rel: str) -> str | None:
    path, name, parts = root / rel, Path(rel).name, Path(rel).parts
    if UNSAFE_PATH.search(rel):
        return "unsafe-path"
    if path.is_symlink():
        return "symlink"
    if parts[:2] in (("docs", "architecture"), ("docs", ".repo-summarize")):
        return "generated-docs"
    if (name.startswith(".env") and name not in ENV_SAFE) or "secrets" in parts[:-1] \
            or any(fnmatch.fnmatch(name, g) for g in SECRET_GLOBS):
        return "secret-file"
    if name in LOCKFILES or name.endswith(".lock"):
        return "lockfile"
    if re.search(r"\.min\.(js|css)$", name):
        return "minified"
    if not path.is_file():
        return "unsupported-type"
    with path.open("rb") as f:
        head = f.read(BINARY_PROBE)
    suffix = path.suffix
    if name.startswith("Dockerfile") or name in {"Makefile", "justfile"}:
        ok = True
    elif suffix == ".md":
        ok = len(parts) == 1 or parts[0] == ".github"
    elif suffix or name.startswith("."):
        ok = suffix in CODE_EXTS or name in ENV_SAFE
    else:
        ok = bool(SHEBANG.match(head.split(b"\n", 1)[0]))
    if not ok:
        return "unsupported-type"
    if b"\0" in head:
        return "binary"
    if path.stat().st_size > MAX_FILE:
        return "too-large"
    return None


def discover(root: Path) -> Discovery:
    files = _list_files(root)
    d = Discovery(root, files, [], {})
    for rel in files:
        reason = _skip_reason(root, rel)
        if reason:
            d.skipped.setdefault(reason, []).append(rel)
        else:
            d.included.append(rel)
    d.included.sort()
    return d


REDACTED = "[REDACTED]"
PEM_BEGIN = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")
PEM_END = re.compile(r"-----END [A-Z ]*PRIVATE KEY-----")
SECRET_RE = re.compile(
    r"AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|sk-[A-Za-z0-9_-]{20,}|xox[abpr]-[A-Za-z0-9-]+"
    r"|(?P<key>(?i:password|secret|token|api_?key)\s*[:=]\s*['\"]?)[^\s'\"]{8,}")


def redact_text(text: str) -> tuple[str, int]:
    out, count, in_pem = [], 0, False
    for line in text.split("\n"):
        if in_pem or PEM_BEGIN.search(line):
            count += not in_pem
            in_pem = not PEM_END.search(line)
            out.append(REDACTED)
            continue
        line, n = SECRET_RE.subn(lambda m: (m["key"] or "") + REDACTED, line)
        count += n
        out.append(line)
    return "\n".join(out), count


def scan_secret(text: str) -> bool:
    return redact_text(text)[1] > 0


@dataclass
class Snapshot:
    dir: Path
    sha256: dict[str, str]
    manifest_sha256: str


def take_snapshot(disc: Discovery, run_dir: Path) -> Snapshot:
    snap = run_dir / "snapshot"
    snap.mkdir(mode=0o700, parents=True, exist_ok=True)
    shas = {}
    for rel in disc.included:
        raw = (disc.root / rel).read_bytes()
        shas[rel] = hashlib.sha256(raw).hexdigest()
        dest = snap / rel
        for d in reversed([p for p in dest.parents if snap in p.parents]):
            d.mkdir(mode=0o700, exist_ok=True)
        red, _ = redact_text(raw.decode("utf-8", "surrogateescape"))
        fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(red.encode("utf-8", "surrogateescape"))
        dest.chmod(0o600)
    manifest = hashlib.sha256(json.dumps(sorted(shas.items()), separators=(",", ":")).encode()).hexdigest()
    return Snapshot(snap, shas, manifest)


def read_snapshot(snap: Snapshot, path: str) -> list[str]:
    lines = (snap.dir / path).read_bytes().decode("utf-8", "replace").split("\n")
    if lines[-1] == "":
        lines.pop()
    return [ln.removesuffix("\r") for ln in lines]


def changed_since_snapshot(disc: Discovery, snap: Snapshot) -> list[str]:
    def sha(rel: str) -> str | None:
        try:
            return hashlib.sha256((disc.root / rel).read_bytes()).hexdigest()
        except OSError:
            return None
    return sorted(rel for rel in disc.included if sha(rel) != snap.sha256.get(rel))


# --- graph ------------------------------------------------------------------

Q = r"""['"]"""
IMPORT_RES = {
    "py": [re.compile(r"^\s*from\s+([._\w]+)\s+import"), re.compile(r"^\s*import\s+([._\w]+)")],
    "js": [re.compile(rf"(?:from|require\(|import\()\s*{Q}([^'\"]+){Q}"), re.compile(rf"^\s*import\s+{Q}([^'\"]+){Q}")],
    "lua": [re.compile(rf"require\s*\(?\s*{Q}([^'\"]+){Q}")],
    "sh": [re.compile(rf"^\s*(?:source|\.)\s+{Q}?([^'\" ;]+)")],
    "c": [re.compile(r'^\s*#\s*include\s*"([^"]+)"')],
}
LANG_OF = {"py": "py", "js": "js", "jsx": "js", "ts": "js", "tsx": "js", "lua": "lua", "sh": "sh", "zsh": "sh",
           "c": "c", "h": "c", "cpp": "c", "hpp": "c"}
COMMENT = {"py": ("#",), "sh": ("#",), "lua": ("--",), "js": ("//", "/*", "*"), "c": ("//", "/*", "*")}
CONFIG_EXTS = {".yml", ".yaml", ".toml", ".json", ".properties", ".ini", ".cfg"}
ENTRY_NAMES = {"main", "app", "index", "server", "cli", "__main__"}


@dataclass
class Graph:
    edges: set[tuple[str, str]]
    shims: set[str]
    entry_points: list[str]
    unsupported_langs: list[str]
    fan_in: dict[str, int]


def _lang(path: str) -> str | None:
    return LANG_OF.get(path.rpartition(".")[2])


def _specs(lang: str, line: str) -> list[str]:
    return [m[1] for rx in IMPORT_RES[lang] if (m := rx.search(line))]


def _norm(p: str) -> str:
    out: list[str] = []
    for part in p.split("/"):
        if part == "..":
            out and out.pop()
        elif part not in ("", "."):
            out.append(part)
    return "/".join(out)


def _dir(p: str) -> str:
    return p.rpartition("/")[0]


def _resolver(files: list[str]):
    exact: dict[str, str] = {}
    suffix: dict[str, str] = {}
    amb: set[str] = set()

    def add(key: str, p: str) -> None:
        exact.setdefault(key, p)
        parts = key.split("/")
        for i in range(len(parts) - 1, -1, -1):
            s = "/".join(parts[i:])
            if suffix.get(s, p) != p:
                amb.add(s)
            else:
                suffix[s] = p

    for p in files:
        noext = re.sub(r"\.[^./]+$", "", p)
        add(noext, p)
        add(p, p)
        if re.search(r"(^|/)(index|__init__|init|mod)$", noext):
            d = re.sub(r"/?(index|__init__|init|mod)$", "", noext)
            if d:
                add(d, p)

    def uniq(key: str) -> str | None:
        return suffix[key] if key in suffix and key not in amb else None

    def resolve(f: str, spec: str) -> str | None:
        ext = f.rpartition(".")[2]
        if re.match(r"\.\.?/", spec):
            return exact.get(_norm(_dir(f) + "/" + spec))
        if ext == "py" and spec.startswith("."):
            rest = spec.lstrip(".")
            if not rest:
                return None
            base = _dir(f)
            for _ in range(len(spec) - len(rest) - 1):
                base = _dir(base)
            return exact.get(_norm(base + "/" + rest.replace(".", "/")))
        if ext in ("py", "lua"):
            return uniq(spec.replace(".", "/"))
        if LANG_OF.get(ext) == "js":
            return uniq(spec[2:]) if re.match(r"[@~]/", spec) else None
        return uniq(spec.rsplit("/", 1)[-1] if "$" in spec else spec)

    return resolve


def _is_shim(lang: str, lines: list[str]) -> bool:
    body = [s for ln in lines if (s := ln.strip()) and not s.startswith(COMMENT[lang])]
    imports = sum(bool(_specs(lang, s)) for s in body)
    return imports > 0 and imports / len(body) >= SHIM_RATIO


def _toml(snap: Snapshot, path: str, included: list[str]) -> dict:
    try:
        return tomllib.loads("\n".join(read_snapshot(snap, path))) if path in included else {}
    except (tomllib.TOMLDecodeError, OSError):
        return {}


def _json(snap: Snapshot, path: str, included: list[str]) -> dict:
    try:
        data = json.loads("\n".join(read_snapshot(snap, path))) if path in included else {}
    except (ValueError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def _entry_points(snap: Snapshot, included: list[str]) -> list[str]:
    inc, found = set(included), set()
    for p in included:
        name, _, ext = Path(p).name.rpartition(".")
        if name in ENTRY_NAMES and f".{ext}" in CODE_EXTS - CONFIG_EXTS:
            found.add(p)
    scripts = _toml(snap, "pyproject.toml", included).get("project", {}).get("scripts", {})
    for target in scripts.values() if isinstance(scripts, dict) else []:
        mod = str(target).split(":")[0].strip().replace(".", "/")
        found.update(c for c in (f"{mod}.py", f"src/{mod}.py", f"{mod}/__init__.py", f"src/{mod}/__init__.py")
                     if c in inc)
    bins = _json(snap, "package.json", included).get("bin", {})
    for b in [bins] if isinstance(bins, str) else bins.values() if isinstance(bins, dict) else []:
        found.update({_norm(str(b))} & inc)
    for p in included:
        if not Path(p).name.startswith("Dockerfile"):
            continue
        for line in read_snapshot(snap, p):
            m = re.match(r"\s*(?:CMD|ENTRYPOINT)\s+(.*)", line, re.I)
            if not m:
                continue
            try:
                args = json.loads(m[1]) if m[1].lstrip().startswith("[") else shlex.split(m[1])
            except ValueError:
                continue
            found.update(next(({_norm(str(a))} & inc for a in args if _norm(str(a)) in inc), set()))
    return sorted(found)


def build_graph(snap: Snapshot, included: list[str]) -> Graph:
    resolve = _resolver(included)
    base: dict[str, set[str]] = {}
    shims: set[str] = set()
    for f in included:
        if not (lang := _lang(f)):
            continue
        lines = read_snapshot(snap, f)
        if _is_shim(lang, lines):
            shims.add(f)
        for ln in lines:
            for spec in _specs(lang, ln):
                if (t := resolve(f, spec)) and t != f:
                    base.setdefault(f, set()).add(t)
    edges = {(a, t) for a, ts in base.items() for t in ts}
    edges |= {(a, t) for a, s in edges if s in shims for t in base.get(s, ()) if t != a}
    fan_in: dict[str, int] = {}
    for _, t in edges:
        fan_in[t] = fan_in.get(t, 0) + 1
    exts = {Path(f).suffix for f in included} & CODE_EXTS - CONFIG_EXTS
    unsupported = sorted(e[1:] for e in exts if e[1:] not in LANG_OF)
    return Graph(edges, shims, _entry_points(snap, included), unsupported, fan_in)


def _workflow_runs(lines: list[str]) -> list[str]:
    out, i = [], 0
    while i < len(lines):
        m = re.match(r"(\s*(?:-\s+)?)run:\s*(.*)$", lines[i])
        i += 1
        if not m:
            continue
        val = m[2].strip()
        if re.fullmatch(r"[|>][+-]?", val):
            indent = len(m[1])
            while i < len(lines) and (not lines[i].strip() or len(lines[i]) - len(lines[i].lstrip()) > indent):
                if (s := lines[i].strip()) and not s.startswith("#"):
                    out.append(s)
                i += 1
        elif val:
            out.append(val[1:-1] if len(val) > 1 and val[0] == val[-1] and val[0] in "'\"" else val)
    return out


def manifest_commands(snap: Snapshot, included: list[str]) -> list[str]:
    cmds: list[str] = []
    if "Makefile" in included:
        cmds += [f"make {m[1]}" for ln in read_snapshot(snap, "Makefile")
                 if (m := re.match(r"([A-Za-z0-9_][\w./-]*)\s*:(?!=)", ln))]
    scripts = _json(snap, "package.json", included).get("scripts", {})
    cmds += [f"npm run {k}" for k in scripts] if isinstance(scripts, dict) else []
    scripts = _toml(snap, "pyproject.toml", included).get("project", {}).get("scripts", {})
    cmds += list(scripts) if isinstance(scripts, dict) else []
    if "justfile" in included:
        cmds += [f"just {m[1]}" for ln in read_snapshot(snap, "justfile")
                 if (m := re.match(r"@?([A-Za-z_][\w-]*)(?:\s+[^:=]*)?:(?!=)", ln))]
    for p in included:
        if re.fullmatch(r"\.github/workflows/[^/]+\.ya?ml", p):
            cmds += _workflow_runs(read_snapshot(snap, p))
    return list(dict.fromkeys(cmds))


def import_path_len(g: Graph, a: str, b: str, max_len: int = 2) -> int | None:
    adj: dict[str, set[str]] = {}
    for x, y in g.edges:
        adj.setdefault(x, set()).add(y)
        adj.setdefault(y, set()).add(x)
    seen, frontier = {a}, {a}
    for d in range(max_len + 1):
        if b in frontier:
            return d
        frontier = {n for f in frontier for n in adj.get(f, ())} - seen
        seen |= frontier
    return None


@dataclass(frozen=True)
class Options:
    path: Path
    estimate: bool
    dry_run: bool
    status: bool
    max_calls: int | None
    force: bool
    replan: bool
    open: bool
    clean: bool
    unsafe_backend: bool


def parse_args(argv: list[str]) -> Options:
    p = argparse.ArgumentParser(prog="repo-summarize", description=__doc__)
    p.add_argument("path", nargs="?", type=Path, default=Path("."))
    p.add_argument("--estimate", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--status", action="store_true")
    p.add_argument("--max-calls", type=int)
    p.add_argument("--force", action="store_true")
    p.add_argument("--replan", action="store_true")
    p.add_argument("--open", action="store_true")
    p.add_argument("--clean", action="store_true")
    p.add_argument("--unsafe-backend", action="store_true")
    return Options(**vars(p.parse_args(argv)))


def main(argv: list[str]) -> int:
    try:
        parse_args(argv)
    except SystemExit as e:
        if e.code == 0:
            raise
        return EXIT_USAGE
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
